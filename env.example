# 本地先跑通、不向 api.coze.cn 上报 Loop 追踪时，取消下一行注释（可不填 COZE_LOOP_API_TOKEN）。
# SLX_LOCAL_NO_COZE_LOOP=1

# kt_workflow：DeepSeek 大模型分析（kt_analyze 节点，复制为 .env 后填写）
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# KT_ANALYSIS_MOCK_LLM=1

# KT_CHAPTER_LLM=1                 # 叙述型小节 LLM 生成（1/2/9 章等）；0=仅模板
# KT_CHAPTER_LLM_MOCK=0            # 1=章节 LLM 也用占位，不走 DeepSeek

# kt_workflow：PDF 三层提取（MinerU GPU + 图目录 + 视觉 API）
# 安装 MinerU：scripts/install_extract_deps.ps1
# 缓存目录默认在项目内 E:\...\slx_01\var\cache（不占 C:\Users\...）
# KT_CACHE_ON_PROJECT=1
# MINERU_MODEL_SOURCE=modelscope
# KT_MINERU_PYTHON=E:\cursor_files\slx_01\.venv-extract\Scripts\python.exe
# KT_MINERU_CLI=E:\cursor_files\slx_01\.venv-extract\Scripts\mineru.exe
# (install_extract_deps.ps1 会生成 .env.mineru.local，可合并进 .env)
# KT_EXTRACT_BACKEND=auto          # auto | mineru | pymupdf
# KT_MINERU_BACKEND=pipeline       # RTX 5060 推荐 pipeline
# KT_MINERU_LANG=ch                # 中文论文；英文可改 en
# KT_EXTRACT_MAX_CHARS=120000
# KT_EXTRACT_MOCK=0                # 1=跳过 MinerU（开发用）
#
# 视觉 API（插图理解，推荐阿里云 Qwen-VL 兼容模式，成本较低）
# KT_VISION_API_KEY=
# KT_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# KT_VISION_MODEL=qwen-vl-plus
# KT_MAX_FIGURES_FOR_VL=8
# KT_VISION_MOCK=0                 # 1=跳过视觉调用

# kt_workflow：不设 KT_WORKFLOW_DATABASE_URL 时，每次 CLI/HTTP 运行使用独立
#   var/kt_workflow/databases/<run_id>.sqlite；若连接 Postgres 则全库共用该 URL。
# KT_WORKFLOW_DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/kt_workflow
# KT_WORKFLOW_SQL_ECHO=0

# coze_coding_dev_sdk.LLMClient 所需（复制为 .env 后按需修改）
# 本地最简：可只设 ARK_API_KEY + OPENAI_BASE_URL（与 COZE_INTEGRATION_* 二选一）
# OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 注意：若 BASE_URL 指向火山方舟，Bearer 必须是方舟控制台里的 API Key，不能填 Coze 的 sk-。
# bp_simple compose 会优先 ARK_API_KEY / OPENAI_API_KEY，再回退 COZE_WORKLOAD_IDENTITY_API_KEY。
COZE_WORKLOAD_IDENTITY_API_KEY=
ARK_API_KEY=
# 方舟 chat 的 model 一般填控制台推理接入点 ID（ep-……），不填则用 config 里模型名
ARK_MODEL=

# 无模型 Key 时先验证流程可设为 1；有 Key 后删掉或置 0
# BP_SIMPLE_MOCK_LLM=1
# OpenAI 兼容网关：火山方舟（豆包）；若仅用 OPENAI_BASE_URL 可不设下面两项
COZE_INTEGRATION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
COZE_INTEGRATION_MODEL_BASE_URL=https://ark.cn-beijing.volces.com/api/v3